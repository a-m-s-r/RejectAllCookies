{
  "name": "minimum-consent",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm build:firefox",
    "web-ext:lint": "web-ext lint --source-dir .output/firefox-mv3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "happy-dom": "20.11.2",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vitest": "3.2.4",
    "web-ext": "8.9.0",
    "wxt": "0.20.27"
  }
}
